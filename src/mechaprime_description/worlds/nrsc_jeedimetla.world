      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MAIN BUILDING — RIGHT SIDE (large light block, east campus)  -->
    <!-- L-shaped: main block + north extension + south annex         -->
    <!-- ============================================================ -->
    <model name="building_main_block">
      <static>true</static>
      <pose>6.5 1.0 1.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>9.0 7.0 3.0</size></box></geometry>
          <material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.88 0.86 0.82 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>9.0 7.0 3.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="building_main_north_ext">
      <static>true</static>
      <pose>9.5 5.0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 3.5 2.0</size></box></geometry>
          <material><ambient>0.88 0.86 0.82 1</ambient><diffuse>0.88 0.86 0.82 1</diffuse></material>
        </visual>
