<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <world name="nrsc_jeedimetla">

    <physics type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>

    <!-- GROUND PLANE — sandy/dirt tone matching Bhuvan aerial -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.50 0.44 1</ambient><diffuse>0.55 0.50 0.44 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- ROADS                                                         -->
    <!-- ============================================================ -->

    <!-- Top horizontal road along north boundary -->
    <model name="road_top_horizontal">
      <static>true</static>
      <pose>0 10.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>25 2.5 0.01</size></box></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>25 2.5 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- Right vertical road along east boundary -->
    <model name="road_right_vertical">
      <static>true</static>
      <pose>11.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.5 23 0.01</size></box></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>2.5 23 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- Main entrance road from south gate inward -->
    <model name="road_main_entrance">
      <static>true</static>
      <pose>0 -8.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 7 0.01</size></box></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>4 7 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- Internal road between warehouse block and main building -->
    <model name="road_internal_ew">
      <static>true</static>
      <pose>0 -3.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>20 3 0.01</size></box></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>20 3 0.01</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- OPEN DIRT GROUND (reddish-brown, centre of campus)           -->
    <!-- ============================================================ -->
    <model name="open_ground_centre">
      <static>true</static>
      <pose>-1.0 2.5 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5.5 6 0.006</size></box></geometry>
          <material><ambient>0.60 0.40 0.25 1</ambient><diffuse>0.60 0.40 0.25 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>5.5 6 0.006</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- TREE CLUSTER (dark green, centre campus)                     -->
    <!-- ============================================================ -->
    <model name="trees_centre">
      <static>true</static>
      <pose>-1.5 1.0 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>4 4 0.006</size></box></geometry>
          <material><ambient>0.15 0.40 0.15 1</ambient><diffuse>0.15 0.40 0.15 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>4 4 0.006</size></box></geometry></collision>
      </link>
    </model>

