          <geometry><box><size>3.5 5.0 1.5</size></box></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>3.5 5.0 1.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- CIRCULAR WATER TANKS (2 cylinders visible top-centre)        -->
    <!-- ============================================================ -->
    <model name="tank_left">
      <static>true</static>
      <pose>-1.5 4.5 0.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.7</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.60 0.60 0.65 1</ambient><diffuse>0.60 0.60 0.65 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><cylinder><radius>0.7</radius><length>1.6</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="tank_right">
      <static>true</static>
      <pose>0.2 4.5 0.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.7</radius><length>1.6</length></cylinder></geometry>
