    <!-- LEFT WAREHOUSE / SOLAR PANEL BUILDINGS (3 sections, west)    -->
    <!-- Dark-roofed industrial buildings visible on Bhuvan image     -->
    <!-- ============================================================ -->
    <model name="building_warehouse_A">
      <static>true</static>
      <pose>-9.5 1.5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.5 5.0 1.5</size></box></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>3.5 5.0 1.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="building_warehouse_B">
      <static>true</static>
      <pose>-7.0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.5 5.0 1.5</size></box></geometry>
          <material><ambient>0.30 0.30 0.30 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>3.5 5.0 1.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="building_warehouse_C">
      <static>true</static>
      <pose>-4.5 1.5 0.75 0 0 0</pose>
      <link name="link">
