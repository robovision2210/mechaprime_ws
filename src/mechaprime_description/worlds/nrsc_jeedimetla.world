      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 0.6 2.5</size></box></geometry>
          <material><ambient>0.85 0.30 0.10 1</ambient><diffuse>0.85 0.30 0.10 1</diffuse></material>
        </visual>
        <collision name="collision"><geometry><box><size>0.6 0.6 2.5</size></box></geometry></collision>
